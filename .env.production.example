# Production is a static same-origin site. Browser API calls remain relative
# to https://aidd.y1zhou.com and Caddy proxies /api/* to FastAPI.
BIOMODALS_PUBLIC_URL=https://aidd.y1zhou.com

# Used only by a local Vite preview of the production build, not embedded in
# browser JavaScript and not used by production Caddy.
BIOMODALS_API_PROXY_TARGET=http://127.0.0.1:8000
