# Browser origin served by the development reverse proxy.
BIOMODALS_PUBLIC_URL=http://localhost:5173

# Server-only Vite proxy target. This is never exposed to browser code.
BIOMODALS_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional source for api:generate/api:check. Defaults to the local API above.
BIOMODALS_OPENAPI_URL=http://127.0.0.1:8000/openapi.json
