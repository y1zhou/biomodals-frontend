{
  "name": "biomodals-frontend",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "api:generate": "openapi-typescript ${BIOMODALS_OPENAPI_URL:-http://127.0.0.1:4144/openapi.json} -o src/api/schema.d.ts --immutable --alphabetize",
    "api:check": "bun run api:generate --check",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "e2e:serve": "node e2e/serve.ts",
    "lint": "oxlint",
    "test": "bun test tests",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/react-query": "^5.101.2",
    "anser": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "molstar": "5.11.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "patchedDependencies": {
    "molstar@5.11.0": "patches/molstar@5.11.0.patch"
  }
}
